# ─── Senler (ВК) ──────────────────────────────────────────
# Из developer-приложения в кабинете Senler: «ID приложения» и «Секретный ключ».
SENLER_APP_ID=
SENLER_SECRET_KEY=

# ─── Salebot (Telegram) ───────────────────────────────────
# По одному токену на проект. Имена ключей произвольные,
# главное — то же написать в channels.py → SALEBOT_PROJECTS.
SALEBOT_TOKEN_PROJECT_1=
SALEBOT_TOKEN_PROJECT_2=
SALEBOT_TOKEN_PROJECT_3=
SALEBOT_TOKEN_PROJECT_4=

# ─── Postgres с данными AmoCRM ────────────────────────────
AMO_PG_HOST=
AMO_PG_PORT=5432
AMO_PG_DB=
AMO_PG_USER=
AMO_PG_PASSWORD=

# ─── Google Sheets ────────────────────────────────────────
# Путь к JSON service account.
GOOGLE_CREDENTIALS_PATH=./service-account.json
# ID Google-таблицы (из URL: docs.google.com/spreadsheets/d/<ID>/edit)
GSHEET_ID=

# ─── Прочее ──────────────────────────────────────────────
TZ=Europe/Moscow
# Telegram для алертов о падении джобы (опционально).
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=
